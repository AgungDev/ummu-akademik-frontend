# Kosongkan untuk memakai proxy Vite menuju Kong lokal di localhost:7000.
# Pada deployment, isi dengan origin Auth Service yang dapat diakses browser.
VITE_AUTH_BASE_URL=http://localhost:7000

# Base URL API; kosong berarti memakai origin frontend (proxy Vite saat lokal).
VITE_API_BASE_URL=http://localhost:7000
